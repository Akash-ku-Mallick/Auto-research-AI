{
  "openapi": "3.0.0",
  "info": {
    "title": "ResearchPulse API",
    "version": "1.0.0",
    "description": "API Documentation for ResearchPulse Backend"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/api/config": {
      "post": {
        "summary": "Save or update a system configuration key",
        "description": "Saves a specific key-value pair to the system configuration store (e.g. DATABASE_URL).",
        "tags": [
          "Configuration"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "key",
                  "value"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Configuration key string"
                  },
                  "value": {
                    "type": "string",
                    "description": "Configuration value string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Configuration saved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {},
  "tags": []
}